# DropPoint SG - environment variables
# Copy this file to .env and fill in your own values. Never commit .env.

# --- OneMap authentication (choose ONE approach) ---

# Option A: quick start. Paste a token from https://www.onemap.gov.sg
# OneMap tokens expire after about three days, so this will eventually stop working.
ONEMAP_TOKEN=

# Option B: long-term. Your OneMap account email and password.
# The client uses these to fetch and refresh its own token automatically.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# --- Telegram ---
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# --- Optional tuning (defaults shown; uncomment to override) ---
# MAX_DRIVER_OVERHEAD_FRAC=0.5
# REQUIRE_FAIR_PROPORTION=true
# OBJECTIVE=efficient
# MAX_CANDIDATES_EVALUATED=15
# CORRIDOR_MAX_OFFSET_KM=3.0
# DEFAULT_DEPART=now
# SHOW_NEAR_MISS=false
# PT_MAX_WALK_DISTANCE_M=1000
# PT_NUM_ITINERARIES=3

# --- Multi-drop tuning (2-3 passengers, one shared route; defaults shown) ---
# Unset = no hard cap on the driver's extra time; plans are ranked by net time saved
# and the driver's extra minutes are always shown. Set e.g. 1.0 to cap at +100%.
# MULTI_MAX_DRIVER_OVERHEAD_FRAC=
# MULTI_ROUTE_CANDIDATES=4        # stations per passenger from the A->B corridor
# MULTI_DEST_CANDIDATES=2         # stations per passenger toward their destination
# MULTI_CORRIDOR_MAX_OFFSET_KM=5.0
# MULTI_NUM_OPTIONS=4             # how many route options to show
# MULTI_VERIFY_TOP=8              # plans re-costed with real inter-stop drive times
# INTER_STOP_SPEED_KMH=28.0       # haversine estimate speed used for pre-ranking
# STOP_OVERHEAD_MIN=1.5           # minutes lost pulling over per stop

# --- Pick-up convenience meets (defaults shown) ---
# A meeting point may leave a passenger up to this many minutes slower than their
# own public-transport trip (being collected is the point), and must cut their PT
# leg to at most this fraction of that trip to be offered at all.
# PICKUP_RIDER_TOLERANCE_MIN=5.0
# PICKUP_PT_LEG_MAX_FRAC=0.8
# PICKUP_SPREAD_CANDIDATES=8      # stations nominated along each passenger's corridor
